[Unit]
Description=Verify persistent Btrfs service-data subvolumes
RequiresMountsFor=/var/lib/service-data
After=systemd-tmpfiles-setup.service
Before=user@1010.service user@1011.service user@1012.service

[Service]
Type=oneshot
ExecStartPre=/usr/libexec/ensure-service-config-ownership
ExecStart=/usr/libexec/verify-service-data headscale caddy adguard
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
