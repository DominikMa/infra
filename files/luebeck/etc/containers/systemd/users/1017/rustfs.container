[Unit]
Description=RustFS S3 object storage
ConditionPathExists=/etc/container-services/rustfs/rustfs.env
PartOf=containers.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Container]
Image=docker.io/rustfs/rustfs:latest
AutoUpdate=registry
ContainerName=rustfs
Network=rustfs.network
Timezone=Europe/Berlin
# Das Image laeuft als rustfs (10001); keep-id bildet ihn auf den
# Host-Benutzer rustfs ab, damit die Objekte direkt ihm gehoeren.
UserNS=keep-id:uid=10001,gid=10001
Environment=RUSTFS_VOLUMES=/data
Environment=RUSTFS_ADDRESS=0.0.0.0:9000
# Obsidian LiveSync greift direkt aus den Apps zu: Desktop (Electron),
# iOS (Capacitor) und Android.
Environment=RUSTFS_CORS_ALLOWED_ORIGINS=app://obsidian.md,capacitor://localhost,http://localhost
Environment=RUSTFS_CONSOLE_ENABLE=true
Environment=RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
Environment=RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=https://s3-admin.home.mairhoefer.xyz
EnvironmentFile=/etc/container-services/rustfs/rustfs.env
Volume=/var/lib/service-data/rustfs:/data:Z
PublishPort=127.0.0.1:17001:9000/tcp
PublishPort=127.0.0.1:17002:9001/tcp
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=30s
TimeoutStartSec=900
CPUWeight=50
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=containers.target
