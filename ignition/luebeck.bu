variant: fcos
version: 1.7.0

ignition:
  config:
    merge:
      - local: build/luebeck/common.ign

storage:
  directories:
    - path: /etc/ssh/authorized_keys
      mode: 0700
  files:
    - path: /etc/subuid
      mode: 0644
      overwrite: true
      contents:
        local: ignition/luebeck/subids
    - path: /etc/subgid
      mode: 0644
      overwrite: true
      contents:
        local: ignition/luebeck/subids
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: |
          luebeck
    - path: /etc/image-rebase/image-ref
      mode: 0644
      contents:
        local: local/luebeck/image-ref
    - path: /etc/ssh/authorized_keys/headscale
      mode: 0600
      user:
        id: 1010
      group:
        id: 1010
      contents:
        local: local/luebeck/authorized_keys
    - path: /etc/ssh/authorized_keys/adguard
      mode: 0600
      user:
        id: 1012
      group:
        id: 1012
      contents:
        local: local/luebeck/authorized_keys
