variant: fcos
version: 1.7.0

passwd:
  users:
    - name: core
      ssh_authorized_keys_local:
        - authorized_keys

storage:
  disks:
    - device: /dev/disk/by-id/coreos-boot-disk
      wipe_table: false
      partitions:
        - number: 4
          label: root
          size_mib: 0
          resize: true
  filesystems:
    - device: /dev/disk/by-partlabel/root
      format: btrfs
      wipe_filesystem: true
      label: root
  directories:
    - path: /var/lib/image-rebase
      mode: 0700
  files:
    - path: /etc/image-rebase/rebase.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          state_dir=/var/lib/image-rebase
          image_ref_file=/etc/image-rebase/image-ref
          unsigned_marker=${state_dir}/unsigned-requested
          signed_marker=${state_dir}/signed-requested
          image_ref=$(tr -d '\n' < "${image_ref_file}")

          if [[ ! -e "${unsigned_marker}" ]]; then
              rpm-ostree rebase --bypass-driver "ostree-unverified-registry:${image_ref}"
              touch "${unsigned_marker}"
              systemctl reboot
              exit 0
          fi

          if [[ ! -e "${signed_marker}" ]]; then
              rpm-ostree rebase --bypass-driver "ostree-image-signed:docker://${image_ref}"
              touch "${signed_marker}"
              systemctl reboot
          fi

systemd:
  units:
    - name: image-rebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase Fedora CoreOS to the signed system image
        Wants=network-online.target
        After=network-online.target
        ConditionPathExists=/etc/image-rebase/image-ref
        ConditionPathExists=!/var/lib/image-rebase/signed-requested

        [Service]
        Type=oneshot
        ExecStart=/etc/image-rebase/rebase.sh
        Restart=on-failure
        RestartSec=30s

        [Install]
        WantedBy=multi-user.target
